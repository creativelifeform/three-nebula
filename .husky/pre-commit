# Keep the three version shown in README.md in sync with package.json.
# Only runs when package.json is part of the commit, and only stages README
# when the sync actually changed it — so ordinary commits are untouched.
if git diff --cached --name-only | grep -qx 'package.json'; then
  node scripts/sync-readme-three-version.mjs
  if ! git diff --quiet -- README.md; then
    git add README.md
    echo "pre-commit: synced three version in README.md from package.json"
  fi
fi

# Type-check when any TS/JS or the tsconfig is part of the commit.
if git diff --cached --name-only | grep -qE '\.(ts|tsx|js|mjs|cjs)$|(^|/)tsconfig.*\.json$'; then
  echo "pre-commit: type-checking (tsc --noEmit)"
  npm run typecheck
fi

# Check formatting when any linted src/test source is part of the commit — CI
# runs the same check (npm run lint -> format:check), so catch it before push.
if git diff --cached --name-only | grep -qE '^(src|test)/.*\.(js|ts)$'; then
  echo "pre-commit: checking formatting (prettier)"
  npm run format:check
fi
