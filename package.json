{
  "name": "three-nebula",
  "version": "12.0.0",
  "description": "WebGL based 3D particle engine",
  "main": "./dist/three-nebula.cjs",
  "module": "./dist/three-nebula.mjs",
  "types": "./dist/types/index.d.ts",
  "unpkg": "./dist/three-nebula.umd.js",
  "jsdelivr": "./dist/three-nebula.umd.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/three-nebula.mjs",
      "require": "./dist/three-nebula.cjs"
    }
  },
  "directories": {
    "docs": "docs",
    "website": "website"
  },
  "scripts": {
    "build": "vite build && npm run build:types",
    "build:types": "tsc -p tsconfig.types.json",
    "dev": "vite build --watch",
    "docs": "serve docs",
    "docs:build": "./scripts/docs-build",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "npm run format:check && oxlint src test && npx madge --circular src",
    "lint:fix": "oxlint --fix src test && npm run format",
    "git:publish": "./scripts/publish",
    "vr": "node vr/capture-all.mjs",
    "vr:baseline": "node vr/capture-all.mjs --baselines",
    "vr:diff": "node vr/diff.mjs",
    "vr:montage": "node vr/montage.mjs",
    "ci:src": "npm run readme:check-three && npm run typecheck && npm run lint && npm run coverage",
    "ci:website": "npm run ci --prefix website",
    "readme:sync-three": "node scripts/sync-readme-three-version.mjs",
    "readme:check-three": "node scripts/sync-readme-three-version.mjs --check",
    "prepare": "husky",
    "sandbox": "vite --config vite.sandbox.config.js",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{js,ts}\" \"test/**/*.{js,ts}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts}\" \"test/**/*.{js,ts}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/creativelifeform/three-nebula.git"
  },
  "keywords": [
    "particle",
    "three.js",
    "3d"
  ],
  "authors": [
    "a-jie",
    "rohan-deshpande",
    "manthrax"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/creativelifeform/three-nebula/issues"
  },
  "homepage": "https://github.com/creativelifeform/three-nebula#readme",
  "peerDependencies": {
    "@types/three": ">=0.122.0 <1.0.0",
    "three": ">=0.122.0 <1.0.0"
  },
  "peerDependenciesMeta": {
    "@types/three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/lodash": "^4.17.24",
    "@types/node": "^26.1.2",
    "@types/three": "^0.185.1",
    "@vitest/coverage-v8": "^4.1.10",
    "chai": "^4.2.0",
    "domino": "^2.1.1",
    "husky": "^9.1.7",
    "lodash": "^4.17.21",
    "oxlint": "^1.76.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "potpack": "^1.0.1",
    "prettier": "^3.9.6",
    "seedrandom": "^3.0.5",
    "sinon": "^7.1.1",
    "three": "^0.185.1",
    "typescript": "^7.0.2",
    "uuid": "^11.1.1",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
